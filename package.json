{
  "name": "quiz-master-api",
  "version": "1.0.0",
  "description": "Backend API for a Bangladesh competitive examination preparation platform (BCS, bank, NTRCA, admission and more).",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"prisma/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "openapi:generate": "nest build && node dist/scripts/generate-openapi.js",
    "test": "jest --config jest.config.ts --selectProjects unit",
    "test:integration": "jest --config jest.config.ts --selectProjects integration --runInBand",
    "test:all": "jest --config jest.config.ts --runInBand",
    "test:cov": "jest --config jest.config.ts --runInBand --coverage",
    "bank:load": "ts-node --transpile-only prisma/load-question-bank.ts",
    "bank:summary": "ts-node --transpile-only prisma/scripts/bank-summary.ts",
    "bank:sample": "ts-node --transpile-only prisma/scripts/bank-sample.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "@aws-sdk/client-s3": "3.1177.0",
    "@aws-sdk/s3-request-presigner": "3.1177.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.12",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.12",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.12",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "compression": "1.8.2",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "nodemailer": "6.10.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.12",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "1.4.13",
    "@types/node": "22.20.7",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "prisma": "6.19.3",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
