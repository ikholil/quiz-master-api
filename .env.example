# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development                    # development | test | production
PORT=3000
APP_NAME=quiz-master-api
PUBLIC_BASE_URL=http://localhost:3000   # used for signed download links and payment IPN URLs
CORS_ORIGINS=http://localhost:3001      # comma-separated browser origins (Next.js admin). Android sends no Origin.
TRUST_PROXY=false                       # true behind a load balancer / reverse proxy
LOG_LEVEL=debug
WORKERS_ENABLED=true                    # false = API-only instance (run workers separately)
SCHEDULERS_ENABLED=true                 # registers cron jobs (idempotent; safe on many instances)
SWAGGER_ENABLED=false                   # expose /api/docs in production
SHUTDOWN_DRAIN_MS=5000

# ─── Data stores ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://quiz:quiz@localhost:5432/quiz_master?schema=public
REDIS_URL=redis://localhost:6379/0

# ─── Auth (production requires strong, unique secrets ≥ 32 chars) ─────────
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_REFRESH_TOKEN_TTL_DAYS=1
OTP_HMAC_SECRET=dev-otp-secret-change-me-0123456789abcdef
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_IP_HOUR=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
PASSWORD_LOGIN_ENABLED=true
EXPOSE_DEV_OTP=true                     # returns OTP in API responses; ignored in production

# ─── Rate limiting ──────────────────────────────────────────────────────
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10

# ─── Storage ────────────────────────────────────────────────────────────
STORAGE_DRIVER=local                    # local | s3 (AWS S3, Cloudflare R2, MinIO…)
STORAGE_LOCAL_PATH=./storage
STORAGE_SIGNING_SECRET=dev-storage-signing-secret-0123456789
MAX_UPLOAD_BYTES=20971520
S3_BUCKET=quiz-master
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ─── AI (the platform works with AI_PROVIDERS=local and no keys) ────────────
AI_PROVIDERS=local                      # ordered fallback chain, e.g. anthropic,openai,local
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-opus-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_PROVIDER=local             # local | openai (1536-dim)
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_REQUEST_TIMEOUT_MS=30000
AI_FREE_DAILY_MESSAGES=10

# ─── Payments ───────────────────────────────────────────────────────────
PAYMENT_DEFAULT_PROVIDER=sandbox        # sandbox (non-production only) | sslcommerz
WEBHOOK_SANDBOX_SECRET=dev-sandbox-webhook-secret
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
PAYMENT_SUCCESS_REDIRECT_URL=http://localhost:3001/payments/success
PAYMENT_FAIL_REDIRECT_URL=http://localhost:3001/payments/failed

# ─── Notifications ──────────────────────────────────────────────────────
SMS_PROVIDER=console                    # console | http
SMS_HTTP_URL=
SMS_API_KEY=
SMS_SENDER_ID=
EMAIL_PROVIDER=console                  # console | smtp
SMTP_URL=
EMAIL_FROM="Quiz Master <no-reply@example.com>"
PUSH_PROVIDER=console                   # console | fcm
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ─── Monitoring ─────────────────────────────────────────────────────────
ERROR_WEBHOOK_URL=                      # optional alert webhook for 5xx errors

# ─── Seed ───────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_PASSWORD=ChangeMe123!
